MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/backend2?retryWrites=true&w=majority
PORT=8080

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/sessions/github/callback

SESSION_SECRET=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Token de recuperacion de contraseña: secreto propio y expiracion de 1h
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=1h

# URL publica de la app, se usa para armar el link del mail de reset
APP_BASE_URL=http://localhost:8080

# Mailing (Nodemailer).
# Opcion A: servicio conocido (gmail, outlook, etc.) + usuario/contraseña de app.
# IMPORTANTE: genera TU contraseña de aplicacion en https://myaccount.google.com/apppasswords.
# Tener 2FA (2 pasos activado si no lo tienes)
MAIL_SERVICE=gmail
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Opcion B: SMTP propio (Mailtrap, SendGrid, etc.). Si definis MAIL_HOST,
# se ignora MAIL_SERVICE.
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_SECURE=false
