<h2>Restablecer contraseña</h2>

<p>Elegí tu nueva contraseña. No puede ser igual a la anterior.</p>

<form id="resetForm">
    <input type="hidden" name="token" value="{{token}}">
    <input type="password" name="password" placeholder="Nueva contraseña" required>
    <input type="password" name="confirmPassword" placeholder="Confirmar nueva contraseña" required>
    <button type="submit">Restablecer contraseña</button>
</form>

<p><a href="/login">Volver al login</a></p>

<div id="msg"></div>

<script>
    document.getElementById('resetForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);
        const msgDiv = document.getElementById('msg');

        if (data.password !== data.confirmPassword) {
            msgDiv.innerHTML = '<p class="alert alert-error">Las contraseñas no coinciden</p>';
            return;
        }

        const res = await fetch('/api/sessions/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: data.token, password: data.password })
        });

        const result = await res.json();

        if (result.status === 'success') {
            msgDiv.innerHTML = '<p class="alert alert-success">Contraseña actualizada. Redirigiendo al login...</p>';
            setTimeout(() => window.location.href = '/login', 1200);
        } else {
            msgDiv.innerHTML = `<p class="alert alert-error">${result.message}</p>`;
        }
    });
</script>
