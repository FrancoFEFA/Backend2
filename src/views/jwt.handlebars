<h2>Prueba JWT sin estado</h2>

<p>Aca probas el flujo con tokens. Registrate o logueate y el token queda guardado en tu navegador.</p>

<h3>1. Registro con JWT</h3>

<p>Completa tus datos para crear una cuenta. La clave se cifra con bcrypt antes de guardarse.</p>

<form id="jwtRegisterForm">
    <input type="text" name="first_name" placeholder="Nombre" required>
    <input type="text" name="last_name" placeholder="Apellido" required>
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Contraseña" required>
    <button type="submit">Registrarme con JWT</button>
</form>

<h3>2. Login con JWT</h3>

<p>Si ya tenes cuenta ingresa tu email y clave para recibir un token nuevo.</p>

<form id="jwtLoginForm">
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Contraseña" required>
    <button type="submit">Ingresar con JWT</button>
</form>

<h3>3. Probar rutas protegidas</h3>

<p>Estos botones envian tu token en el header Authorization con formato Bearer.</p>

<button id="jwtTestCurrentBtn" onclick="testCurrent()">Probar /api/auth/current</button>
<button onclick="testProtected()">Probar /api/auth/protected</button>
<button onclick="clearJwt()" style="background:#6c757d;">Borrar token</button>

<div id="jwtTokenSection">
    <p><strong>Token actual:</strong></p>
    <pre id="jwtTokenBox" style="background:#f0f0f0; padding:10px; border-radius:6px; overflow:auto; word-break:break-all; transition: background 0.5s;">Sin token todavia</pre>
</div>

<div id="jwtMsg"></div>

<script>
    // Muestra el token guardado al abrir la pagina
    function renderToken() {
        const token = localStorage.getItem('jwtToken');
        document.getElementById('jwtTokenBox').textContent = token || 'Sin token todavia';
    }
    renderToken();

    // Guarda el token y te lleva con scroll suave hasta la seccion visual del token
    function saveToken(token, message) {
        localStorage.setItem('jwtToken', token);
        renderToken();
        document.getElementById('jwtMsg').innerHTML = `<p class="alert alert-success">${message}</p>`;

        // Desliza la vista hacia el token para que lo veas sin buscarlo
        const section = document.getElementById('jwtTokenSection');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Resalta la caja del token un momento para que llame la atencion
        const box = document.getElementById('jwtTokenBox');
        if (box) {
            box.style.background = '#d4edda';
            setTimeout(() => { box.style.background = '#f0f0f0'; }, 1500);
        }

        // Pone el foco en probar current para invitarte al siguiente paso
        const nextBtn = document.getElementById('jwtTestCurrentBtn');
        if (nextBtn) {
            setTimeout(() => nextBtn.focus({ preventScroll: true }), 600);
        }
    }

    // Muestra errores de la API para que entiendas que paso
    function showError(message) {
        document.getElementById('jwtMsg').innerHTML = `<p class="alert alert-error">${message}</p>`;
    }

    // Envia el registro a la API y guarda el token que vuelve
    document.getElementById('jwtRegisterForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(e.target));

        const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.status === 'success') {
            saveToken(result.token, 'Registro ok. Ya podes probar las rutas protegidas.');
        } else {
            showError(result.message);
        }
    });

    // Envia el login a la API y guarda el token que vuelve
    document.getElementById('jwtLoginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(e.target));

        const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.status === 'success') {
            saveToken(result.token, 'Login ok. Token guardado.');
        } else {
            showError(result.message);
        }
    });

    // Pide la ruta current mandando el token en el header
    async function testCurrent() {
        const token = localStorage.getItem('jwtToken');
        const res = await fetch('/api/auth/current', {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        const result = await res.json();
        document.getElementById('jwtMsg').innerHTML = `<pre class="alert ${result.status === 'success' ? 'alert-success' : 'alert-error'}" style="overflow:auto;">${JSON.stringify(result, null, 2)}</pre>`;
    }

    // Pide la ruta protegida de ejemplo con el mismo header
    async function testProtected() {
        const token = localStorage.getItem('jwtToken');
        const res = await fetch('/api/auth/protected', {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        const result = await res.json();
        document.getElementById('jwtMsg').innerHTML = `<pre class="alert ${result.status === 'success' ? 'alert-success' : 'alert-error'}" style="overflow:auto;">${JSON.stringify(result, null, 2)}</pre>`;
    }

    // Borra el token para simular un logout sin estado
    function clearJwt() {
        localStorage.removeItem('jwtToken');
        renderToken();
        document.getElementById('jwtMsg').innerHTML = '<p class="alert alert-success">Token borrado.</p>';
    }
</script>
