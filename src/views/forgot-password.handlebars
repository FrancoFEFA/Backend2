<h2>Recuperar contraseña</h2>

<p>Ingresá tu email. Si está registrado, te enviamos un correo con un botón para restablecer tu contraseña. El enlace vence en 1 hora.</p>

<form id="forgotForm">
    <input type="email" name="email" placeholder="Email" required>
    <button type="submit">Enviar correo</button>
</form>

<p><a href="/login">Volver al login</a></p>

<div id="msg"></div>

<script>
    document.getElementById('forgotForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);

        const res = await fetch('/api/sessions/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        const msgDiv = document.getElementById('msg');

        if (result.status === 'success') {
            msgDiv.innerHTML = `<p class="alert alert-success">${result.message}</p>`;
        } else {
            msgDiv.innerHTML = `<p class="alert alert-error">${result.message}</p>`;
        }
    });
</script>
