<h2>Iniciar Sesión</h2>

<p>Ingresá tu email y contraseña para acceder a tu sesión.</p>

<form id="loginForm">
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Contraseña" required>
    <button type="submit">Ingresar</button>
</form>

<div style="text-align:center; margin: 16px 0; color:#666;">— o —</div>

<a href="/api/sessions/github" style="display:block; width:100%; padding:10px; background:#24292e; color:white; text-align:center; border-radius:4px; text-decoration:none; box-sizing:border-box;">
    Ingresar con GitHub
</a>

<p>¿No tenés cuenta? <a href="/register">Registrate acá</a></p>
<p>¿Olvidaste tu contraseña? <a href="/forgot-password">Recuperala acá</a></p>

<div id="msg"></div>

<script>
    // Captura el submit del formulario de login local
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);

        // Envía las credenciales al endpoint de login local
        const res = await fetch('/api/sessions/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        const msgDiv = document.getElementById('msg');

        // Si el login es exitoso redirige al perfil
        if (result.status === 'success') {
            msgDiv.innerHTML = '<p class="alert alert-success">Login exitoso. Redirigiendo...</p>';
            setTimeout(() => window.location.href = '/profile', 800);
        } else {
            msgDiv.innerHTML = `<p class="alert alert-error">${result.message}</p>`;
        }
    });
</script>
