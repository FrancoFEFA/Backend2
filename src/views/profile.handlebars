<h2>Perfil de Usuario</h2>

<p>Esta es una ruta protegida. Solo se accede si hay sesión activa.</p>

<div style="background:#f0f0f0; padding:15px; border-radius:6px;">
    <p><strong>Nombre:</strong> {{user.first_name}} {{user.last_name}}</p>
    <p><strong>Email:</strong> {{user.email}}</p>
    <p><strong>Edad:</strong> {{user.age}}</p>
    <p><strong>Rol:</strong> {{user.role}}</p>
    <p><strong>ID:</strong> {{user._id}}</p>
</div>

<button onclick="logout()">Cerrar Sesión</button>

{{#if (eq user.role "admin")}}
    <p><a href="/admin">Ir al panel Admin</a></p>
{{/if}}

<script>
    // Ejecuta el logout destruyendo la sesion en el servidor
    async function logout() {
        const res = await fetch('/api/sessions/logout', { method: 'GET' });
        // La ruta hace redirect si es HTML, sino vuelve JSON
        if (res.redirected) {
            window.location.href = res.url;
        } else {
            window.location.href = '/login';
        }
    }
</script>
